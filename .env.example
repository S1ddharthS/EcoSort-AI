# Copy to .env only if your process manager loads .env files. The app itself
# reads real environment variables; never commit a production secret.
SECRET_KEY=replace-with-a-long-random-value
PORT=8080

# Persistent paths for Docker/Render/Railway. Leave unset for local defaults.
# ECOSORT_DB=/data/ecosort.db
# ECOSORT_UPLOADS=/data/uploads

# Optional overrides
# LOG_LEVEL=INFO
# WEB_CONCURRENCY=1
# GUNICORN_TIMEOUT=180
# Set to 1 behind Render/Railway/Nginx so rate limiting uses the client IP
# TRUST_PROXY_COUNT=1
